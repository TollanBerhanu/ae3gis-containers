# IEC-104 RTU (substation field device) built on the c104 library. Scenario B.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Common baseline + SSH + Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    rsyslog \
    iproute2 \
    iputils-ping \
    net-tools \
    tcpdump \
    curl \
    wget \
    vim \
    nano \
    procps \
    ca-certificates \
    python3 \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# c104 (IEC-104) in a venv — ships aarch64 + x86_64 wheels, so no source build
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir c104
ENV PATH="/opt/venv/bin:$PATH"

# SSH setup: root password + allow root/password login (lab-only, deliberate)
RUN mkdir /var/run/sshd && \
    echo 'root:pass' | chpasswd && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?UsePAM.*/UsePAM no/' /etc/ssh/sshd_config

COPY app/server.py /opt/app/server.py

EXPOSE 22 2404

# Start logging + SSH in the background, then run the RTU in the foreground.
CMD ["sh", "-c", "rsyslogd; service ssh start; exec python3 /opt/app/server.py"]

# AE3GIS image metadata (see image-standard.md)
LABEL org.opencontainers.image.title="IEC-104 RTU" \
      org.opencontainers.image.description="Ubuntu 24.04 IEC-104 substation RTU (c104) exposing one breaker on TCP 2404. SSH root/pass." \
      io.ae3gis.schema="1" \
      io.ae3gis.type="plc" \
      io.ae3gis.stability="experimental"
