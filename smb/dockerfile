# Simple Samba server (Ubuntu 24.04)
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    SMB_USER=smbuser \
    SMB_PASS=smbpass \
    SMB_WORKGROUP=WORKGROUP \
    SMB_SHARE_NAME=share \
    SMB_SHARE_PATH=/srv/samba/share \
    SMB_READ_ONLY=no \
    SMB_BROWSEABLE=yes \
    SMB_GUEST_OK=no

# Install samba + tini (for sane PID 1)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    samba tini \
    rsyslog \
    net-tools \
    iproute2 \
    iputils-ping \
    tcpdump \
    vim \
    nano \
    curl \
    wget \
    dnsutils \
    nmap \
    netcat-openbsd \
    isc-dhcp-client \
    openssh-server \
    && rm -rf /var/lib/apt/lists/*

# Create share dir and a place for our config/entrypoint
RUN mkdir -p ${SMB_SHARE_PATH} /opt/smb
COPY smb.conf /etc/samba/smb.conf
COPY entrypoint.sh /opt/smb/entrypoint.sh
RUN chmod +x /opt/smb/entrypoint.sh && \
    # Quiet down Samba's default logs inside container
    mkdir -p /var/log/samba && touch /var/log/samba/log.smbd && \
    # Ensure proper permissions
    chown -R root:root /etc/samba && \
    chown -R root:root /opt/smb && \
    chmod -R 755 /opt/smb

RUN mkdir /var/run/sshd && \
    echo 'root:pass' | chpasswd && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?UsePAM.*/UsePAM no/' /etc/ssh/sshd_config

EXPOSE 139 445 22

# Use tini as PID 1, then run our entrypoint
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/smb/entrypoint.sh"]
CMD ["/bin/bash", "-l"]