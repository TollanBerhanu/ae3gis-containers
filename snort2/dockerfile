FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install basic Ubuntu packages + Snort 2
RUN apt-get update && apt-get install -y \
    openssh-server \
    rsyslog \
    net-tools \
    iproute2 \
    iputils-ping \
    tcpdump \
    vim \
    nano \
    curl \
    wget \
    procps \
    snort \
    snort-rules-default \
    && rm -rf /var/lib/apt/lists/*

# SSH setup: root password + allow root/password login
RUN mkdir /var/run/sshd && \
    echo 'root:pass' | chpasswd && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?UsePAM.*/UsePAM no/' /etc/ssh/sshd_config

# Setup Snort log directory
RUN mkdir -p /var/log/snort && \
    chown -R snort:snort /var/log/snort

# Expose SSH port
EXPOSE 22

# Start services: rsyslog and sshd
CMD ["sh", "-c", "rsyslogd && exec /usr/sbin/sshd -D"]

# AE3GIS image metadata (see image-standard.md)
LABEL org.opencontainers.image.title="Snort 2" \
      org.opencontainers.image.description="Ubuntu 24.04 + the packaged Snort 2 with its default rules." \
      io.ae3gis.schema="1" \
      io.ae3gis.type="ids" \
      io.ae3gis.stability="experimental"
