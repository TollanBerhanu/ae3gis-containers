FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    syslog-ng \
    curl \
    net-tools \
    iproute2 \
    isc-dhcp-client \
    vim \
    python3 \
    python3-flask \
    procps \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# syslog-ng config
RUN echo '@version: 3.38' > /etc/syslog-ng/syslog-ng.conf && \
    echo 'options { keep-hostname(yes); };' >> /etc/syslog-ng/syslog-ng.conf && \
    echo 'source s_net { network(transport(udp) port(514)); };' >> /etc/syslog-ng/syslog-ng.conf && \
    echo 'destination d_local { file("/var/log/student.log"); };' >> /etc/syslog-ng/syslog-ng.conf && \
    echo 'log { source(s_net); destination(d_local); };' >> /etc/syslog-ng/syslog-ng.conf

RUN touch /var/log/student.log && chmod 666 /var/log/student.log

# ---- "Authentication" gate ----
# Change these defaults however you want at build-time or run-time.
ENV CONTAINER_USER=admin
ENV CONTAINER_PASS=admin

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 514/udp 5000/tcp 80/tcp

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
