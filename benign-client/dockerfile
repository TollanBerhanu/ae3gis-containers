# Dockerfile for benign client
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install basic Ubuntu packages + Python
# (python3-venv bundles pip; python3-pip is skipped since it recommends the full gcc toolchain)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    python3 \
    python3-venv \
    python-is-python3 \
    openssh-server \
    rsyslog \
    net-tools \
    iproute2 \
    iputils-ping \
    traceroute \
    telnet \
    tcpdump \
    vim \
    nano \
    curl \
    wget \
    procps \
    bind9-dnsutils \
    nmap \
    netcat-openbsd \
    isc-dhcp-client \
    && rm -rf /var/lib/apt/lists/*

# IEC-104 client (c104) in a venv, so this authorized engineering workstation can
# issue legitimate control commands to the RTU (used by the Industroyer tutorial).
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir c104

# A one-word breaker control tool (status|open|close) over IEC-104.
COPY breaker /usr/local/bin/breaker
RUN chmod +x /usr/local/bin/breaker

# SSH setup: root password + allow root/password login
RUN mkdir /var/run/sshd && \
    echo 'root:pass' | chpasswd && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?UsePAM.*/UsePAM no/' /etc/ssh/sshd_config

# Expose SSH port
EXPOSE 22

# Add traffic scripts
COPY run_ping.sh /usr/local/bin/run_ping.sh
COPY run_nmap.sh /usr/local/bin/run_nmap.sh
COPY run_http.sh /usr/local/bin/run_http.sh
COPY run_ftp.sh /usr/local/bin/run_ftp.sh
RUN chmod +x /usr/local/bin/run_*.sh

# Start services: rsyslog and sshd
CMD ["sh", "-c", "rsyslogd && exec /usr/sbin/sshd -D"]

# AE3GIS image metadata (see image-standard.md)
LABEL org.opencontainers.image.title="Benign client" \
      org.opencontainers.image.description="Ubuntu 24.04 client with traffic generators (run_ping.sh, run_http.sh, run_ftp.sh, run_nmap.sh) and a c104 IEC-104 client venv at /opt/venv." \
      io.ae3gis.schema="1" \
      io.ae3gis.type="workstation"
